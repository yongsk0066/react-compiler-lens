{
  "name": "react-compiler-lens",
  "displayName": "React Compiler Lens",
  "description": "CodeLens annotations for React components using the React Compiler as SSOT",
  "version": "0.0.8",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "publisher": "yongsk0066",
  "repository": {
    "type": "git",
    "url": "https://github.com/yongsk0066/react-compiler-lens"
  },
  "homepage": "https://github.com/yongsk0066/react-compiler-lens#readme",
  "bugs": "https://github.com/yongsk0066/react-compiler-lens/issues",
  "keywords": [
    "react",
    "react-compiler",
    "codelens",
    "server-components",
    "nextjs",
    "memoization",
    "optimization",
    "use client",
    "use server",
    "rsc",
    "jsx",
    "tsx",
    "diagnostics",
    "react server components",
    "compiled output"
  ],
  "preview": true,
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/yongsk0066.react-compiler-lens",
      "href": "https://marketplace.visualstudio.com/items?itemName=yongsk0066.react-compiler-lens",
      "description": "VS Marketplace Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/yongsk0066.react-compiler-lens",
      "href": "https://marketplace.visualstudio.com/items?itemName=yongsk0066.react-compiler-lens",
      "description": "Installs"
    },
    {
      "url": "https://img.shields.io/github/license/yongsk0066/react-compiler-lens",
      "href": "https://github.com/yongsk0066/react-compiler-lens/blob/main/LICENSE",
      "description": "License"
    }
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Linters",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#20232a",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/client/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reactCompilerLens.refresh",
        "title": "React Compiler Lens: Refresh"
      },
      {
        "command": "reactCompilerLens.showProblems",
        "title": "React Compiler Lens: Show Problems"
      },
      {
        "command": "reactCompilerLens.peekCompiled",
        "title": "React Compiler Lens: Peek Compiled Output"
      },
      {
        "command": "reactCompilerLens.toggleEnabled",
        "title": "React Compiler Lens: Toggle On/Off"
      }
    ],
    "walkthroughs": [
      {
        "id": "reactCompilerLens.gettingStarted",
        "title": "Get Started with React Compiler Lens",
        "description": "See React Compiler analysis results as CodeLens annotations.",
        "steps": [
          {
            "id": "openReactFile",
            "title": "Open a React Component",
            "description": "Open any `.tsx` or `.jsx` file. CodeLens annotations appear automatically above components.",
            "media": {
              "markdown": "walkthrough/01-open-file.md"
            }
          },
          {
            "id": "viewCompiled",
            "title": "View Compiled Output",
            "description": "Click an **Optimized** CodeLens to see the compiler's output.\n\n[View Compiled Output](command:reactCompilerLens.peekCompiled)",
            "media": {
              "markdown": "walkthrough/02-view-compiled.md"
            }
          },
          {
            "id": "checkDiagnostics",
            "title": "Check Diagnostics",
            "description": "Compilation errors appear in the Problems panel.\n\n[Show Problems](command:reactCompilerLens.showProblems)",
            "media": {
              "markdown": "walkthrough/03-diagnostics.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "React Compiler Lens",
      "properties": {
        "reactCompilerLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable React Compiler Lens"
        },
        "reactCompilerLens.codeLens.serverComponent": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Server Components"
        },
        "reactCompilerLens.codeLens.clientComponent": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Client Components"
        },
        "reactCompilerLens.codeLens.compilationStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show compilation status in CodeLens"
        },
        "reactCompilerLens.codeLens.serverAction": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Server Actions (files with 'use server')"
        },
        "reactCompilerLens.codeLens.serverOnly": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for server-only files (import 'server-only')"
        },
        "reactCompilerLens.codeLens.showDefaultSuffix": {
          "type": "boolean",
          "default": true,
          "description": "Show '(default)' suffix for implicit Server Components in Next.js"
        },
        "reactCompilerLens.codeLens.reactiveValues": {
          "type": "boolean",
          "default": true,
          "description": "Show reactive dependency names in Optimized CodeLens"
        },
        "reactCompilerLens.codeLens.reactiveValuesMaxDisplay": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Max reactive values to show before truncating"
        },
        "reactCompilerLens.codeLens.importedComponentJsxLens": {
          "type": "boolean",
          "default": true,
          "description": "Show component labels at JSX usage sites"
        },
        "reactCompilerLens.codeLens.showInheritedSuffix": {
          "type": "boolean",
          "default": true,
          "description": "Show (inherited) suffix on inherited directive labels"
        },
        "reactCompilerLens.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show compilation errors in Problems panel"
        },
        "reactCompilerLens.diagnostics.severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "info"
          ],
          "default": "warning",
          "description": "Severity level for compilation diagnostics"
        },
        "reactCompilerLens.diagnostics.showDescription": {
          "type": "boolean",
          "default": true,
          "description": "Include extended description in Problems panel diagnostics"
        },
        "reactCompilerLens.diagnostics.showRelatedLocations": {
          "type": "boolean",
          "default": true,
          "description": "Show related source locations in diagnostics"
        },
        "reactCompilerLens.analysis.debounceMs": {
          "type": "integer",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "description": "Delay (ms) before re-analyzing after content changes"
        },
        "reactCompilerLens.framework": {
          "type": "string",
          "enum": [
            "auto",
            "nextjs",
            "none"
          ],
          "default": "auto",
          "description": "Framework detection mode"
        },
        "reactCompilerLens.compiledOutput.viewMode": {
          "type": "string",
          "enum": [
            "side",
            "peek"
          ],
          "default": "side",
          "enumDescriptions": [
            "Open compiled output in a side editor tab (Svelte-style)",
            "Open compiled output in an inline peek view"
          ],
          "description": "How to display compiled output when clicking Optimized CodeLens"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts --watch",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepackage": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.8.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "rolldown": "1.0.0-rc.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
