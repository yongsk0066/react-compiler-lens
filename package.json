{
  "name": "react-compiler-lens",
  "displayName": "React Compiler Lens",
  "description": "CodeLens annotations for React components using the React Compiler as SSOT",
  "version": "0.0.5",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "publisher": "yongsk0066",
  "repository": {
    "type": "git",
    "url": "https://github.com/yongsk0066/react-compiler-lens"
  },
  "homepage": "https://github.com/yongsk0066/react-compiler-lens#readme",
  "bugs": "https://github.com/yongsk0066/react-compiler-lens/issues",
  "keywords": ["react", "react-compiler", "codelens", "server-components", "nextjs"],
  "preview": true,
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/client/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reactCompilerLens.refresh",
        "title": "React Compiler Lens: Refresh"
      },
      {
        "command": "reactCompilerLens.showProblems",
        "title": "React Compiler Lens: Show Problems"
      },
      {
        "command": "reactCompilerLens.peekCompiled",
        "title": "React Compiler Lens: Peek Compiled Output"
      }
    ],
    "configuration": {
      "title": "React Compiler Lens",
      "properties": {
        "reactCompilerLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable React Compiler Lens"
        },
        "reactCompilerLens.codeLens.serverComponent": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Server Components"
        },
        "reactCompilerLens.codeLens.clientComponent": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Client Components"
        },
        "reactCompilerLens.codeLens.compilationStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show compilation status in CodeLens"
        },
        "reactCompilerLens.codeLens.serverAction": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for Server Actions (files with 'use server')"
        },
        "reactCompilerLens.codeLens.serverOnly": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for server-only files (import 'server-only')"
        },
        "reactCompilerLens.codeLens.showDefaultSuffix": {
          "type": "boolean",
          "default": true,
          "description": "Show '(default)' suffix for implicit Server Components in Next.js"
        },
        "reactCompilerLens.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show compilation errors in Problems panel"
        },
        "reactCompilerLens.diagnostics.severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "info"
          ],
          "default": "warning",
          "description": "Severity level for compilation diagnostics"
        },
        "reactCompilerLens.framework": {
          "type": "string",
          "enum": [
            "auto",
            "nextjs",
            "none"
          ],
          "default": "auto",
          "description": "Framework detection mode"
        },
        "reactCompilerLens.compiledOutput.viewMode": {
          "type": "string",
          "enum": [
            "side",
            "peek"
          ],
          "default": "side",
          "enumDescriptions": [
            "Open compiled output in a side editor tab (Svelte-style)",
            "Open compiled output in an inline peek view"
          ],
          "description": "How to display compiled output when clicking Optimized CodeLens"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts --watch",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "rolldown": "1.0.0-rc.10",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
